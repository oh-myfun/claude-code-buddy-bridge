<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd 用户守护进程配置

  安装方法：
    cp extras/dev.cdbb.daemon.plist ~/Library/LaunchAgents/
    # 将下方 /usr/local/bin/ccbb 替换为实际路径（which ccbb）
    launchctl load ~/Library/LaunchAgents/dev.cdbb.daemon.plist

  卸载方法：
    launchctl unload ~/Library/LaunchAgents/dev.cdbb.daemon.plist
    rm ~/Library/LaunchAgents/dev.cdbb.daemon.plist

  日志位置：
    ~/Library/Logs/ccbb/daemon.log
    ~/Library/Logs/ccbb/daemon-error.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ccbb.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <!-- 替换为 `which ccbb` 的输出 -->
        <string>/usr/local/bin/ccbb</string>
        <string>daemon</string>
    </array>

    <!-- 崩溃后自动重启 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 登录后自动启动 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/ccbb-daemon.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/ccbb-daemon-error.log</string>

    <!-- 环境变量配置 -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- 可选：指定 TCP 监听地址和端口 -->
        <!-- <key>CCBB_TCP_HOST</key> -->
        <!-- <string>0.0.0.0</string> -->
        <!-- <key>CCBB_TCP_PORT</key> -->
        <!-- <string>9876</string> -->
    </dict>
</dict>
</plist>
